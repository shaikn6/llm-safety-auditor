# LLM Safety Auditor — environment variables
#
# Every variable here is read by the code; all are optional. With none set the
# API runs against the seeded mock LLM and needs no keys.
# Export them in your shell (or pass them to docker compose); the app does not
# load a .env file by itself.

# --- API ---------------------------------------------------------------
# "development" (default) leaves POST routes open when API_KEYS is empty.
# Any other value makes API_KEYS mandatory (POST routes return 503 without it).
APP_ENV=development

# Optional: comma-separated keys accepted in the X-API-Key header on POST routes.
API_KEYS=

# Set to 1 to serve Swagger UI at /docs and ReDoc at /redoc (off by default).
ENABLE_DOCS=0

# Optional: comma-separated CORS origins
# (default: http://localhost:8501,http://localhost:3000).
CORS_ORIGINS=

# SQLAlchemy database URL.
DATABASE_URL=sqlite:///./llm_safety_auditor.db

# --- Model under audit ---------------------------------------------------
# mock (default) | anthropic | openai
LLM_PROVIDER=mock

# Model name. anthropic defaults to claude-haiku-5-5; required for openai.
LLM_MODEL=

# Optional: only needed when LLM_PROVIDER=anthropic (also: pip install anthropic).
ANTHROPIC_API_KEY=

# Optional: only needed when LLM_PROVIDER=openai (also: pip install openai).
OPENAI_API_KEY=

# Optional: base URL of an OpenAI-compatible server (default: api.openai.com).
OPENAI_BASE_URL=

# LLM Safety Auditor — Environment Variables
# Copy to .env and fill in real values

# Required: Anthropic API key for red-team generation
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: OpenAI API for comparison attacks
OPENAI_API_KEY=sk-your-openai-key-here

# Server config
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Report storage
REPORTS_DIR=./reports

# Rate limiting (requests per minute)
RATE_LIMIT=60
